FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
SAM2_MODEL=facebook/sam2.1-hiera-tiny
CHARACTER_DEVICE=cpu
CHARACTER_INPUT_ROOT=samples
CHARACTER_OUTPUT_ROOT=outputs/character-tasks
CHARACTER_FRAME_INTERVAL_SECONDS=2
SHOT_SCENE_THRESHOLD=10
SHOT_IGNORE_BOTTOM_FRACTION=0.2
DIALOGUE_ASR_MODEL=paraformer-zh
DIALOGUE_VAD_MODEL=fsmn-vad
DIALOGUE_PUNCTUATION_MODEL=ct-punc
DIALOGUE_SPEAKER_MODEL=cam++
LIVE2D_INPUT_ROOT=samples
LIVE2D_OUTPUT_ROOT=outputs/live2d-tasks
LIVE2D_CONVERTER_ARGV=[]
LIVE2D_MANIFEST_GLOB=**/*.model3.json
# LIVE2D_CORE_LIBRARY=/absolute/path/to/libLive2DCubismCore.dylib
# LIVE2D_WEB_CORE_JS=/absolute/path/to/live2dcubismcore.min.js
LIVE2D_NODE_PATH=node
LIVE2D_TIMEOUT_SECONDS=1800
